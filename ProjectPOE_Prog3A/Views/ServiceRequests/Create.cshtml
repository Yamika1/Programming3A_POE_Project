@model ProjectPOE_Prog3A.Models.ServiceRequests

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>ServiceRequests</h4>
<div class="mb-3">
    <a href="/ServiceRequests/Index" class="btn btn-success"> ← Back</a>
</div>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="RequestTypes" class="form-label">Service Request Type</label>
                    <select asp-for="RequestTypes" class="form-control">
                        <option value="">-- Select Service Request Type --</option>
                        <option value="Hardware Support">Hardware Support</option>
                        <option value="Software Installation">Software Installation</option>
                        <option value="Network Connectivity">Network Connectivity</option>
                        <option value="Email Support">Email Support</option>
                        <option value="Password Reset">Password Reset</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="RequestDate" class="control-label"></label>
                <input asp-for="RequestDate" class="form-control" />
                <span asp-validation-for="RequestDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="RequestDescription" class="control-label"></label>
                <input asp-for="RequestDescription" class="form-control" />
                <span asp-validation-for="RequestDescription" class="text-danger"></span>
            </div>

        
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
